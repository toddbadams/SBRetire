{
  "version": "0.2.0",
  "configurations": [
    {
      // Used by the Testing panel's "Debug Test" (purpose: debug-test).
      "name": "Debug tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "sbretire run (example config)",
      "type": "debugpy",
      "request": "launch",
      "module": "sbretire",
      "args": ["run", "--config", "config/model.example.yaml", "--output-dir", "output"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "sbretire run (my config)",
      "type": "debugpy",
      "request": "launch",
      "module": "sbretire",
      "args": ["run", "--config", "config/model.yaml", "--output-dir", "output"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
